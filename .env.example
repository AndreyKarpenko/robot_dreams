# HTTP port. Optional, default 3000.
PORT=3000

# Postgres URL (host/user/db). Password is NOT here — it lives in secrets/db_password.
DB_URL=postgres://app_user:CHANGE_ME@127.0.0.1:6432/shop

# RabbitMQ AMQP URL. Real value lives in the secrets store (hw-11), next to DB_URL.
# Empty boots the API without a broker. Shape: amqp://USER:PASSWORD@127.0.0.1:5672
# 5672 is AMQP. 15672 is the management UI and does not speak AMQP.
BROKER_URL=

# Cache Redis (maxmemory + allkeys-lru). Real value lives in the secrets store (hw-11).
# Empty boots the API without a cache; product reads go to Postgres.
# Shape: redis://127.0.0.1:16379
REDIS_URL=

# Queue Redis (maxmemory-policy noeviction, AOF). Sessions and the shared rate
# limit live here too — the cache instance may evict them. Same secrets store.
# Shape: redis://127.0.0.1:16380
REDIS_QUEUE_URL=

# Log level: debug | info | warn | error. Optional, default info.
LOG_LEVEL=info

# Outbound timeout in ms. Optional, default 5000.
TIMEOUT_MS=5000

# ES256 key id. Real value lives in the secrets store (hw-11). No default.
JWT_KID=

# ES256 private key: PKCS8 PEM, base64. Real value lives in the secrets store.
JWT_PRIVATE_KEY=

# ES256 public key: SPKI PEM, base64. Real value lives in the secrets store.
JWT_PUBLIC_KEY=

# HMAC pepper for refresh-token hashes. Real value lives in the secrets store.
REFRESH_TOKEN_PEPPER=
